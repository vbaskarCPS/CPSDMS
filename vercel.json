{
    "rewrites": [
      { "source": "/", "has": [{ "type": "host", "value": "planner.propertystars.app" }], "destination": "/vijayplanner/" },
      { "source": "/vijayplanner", "destination": "/planner.html" },
      { "source": "/vijayplanner/", "destination": "/planner.html" },
      { "source": "/vijayplanner/:path*", "destination": "/planner.html" },
      { "source": "/roshplanner", "destination": "/planner.html" },
      { "source": "/roshplanner/", "destination": "/planner.html" },
      { "source": "/roshplanner/:path*", "destination": "/planner.html" },
      { "source": "/(.*)", "destination": "/index.html" }
    ]
  }
