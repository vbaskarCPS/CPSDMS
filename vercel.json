{
    "rewrites": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "mainstreetai.propertystars.app"
                }
            ],
            "destination": "/mainstreetai.html"
        },
        {
            "source": "/site/mainstreetai",
            "destination": "/mainstreetai.html"
        },
        {
            "source": "/site/mainstreetai/",
            "destination": "/mainstreetai.html"
        },
        {
            "source": "/vijayplanner",
            "destination": "/planner.html"
        },
        {
            "source": "/vijayplanner/",
            "destination": "/planner.html"
        },
        {
            "source": "/vijayplanner/:path*",
            "destination": "/planner.html"
        },
        {
            "source": "/roshplanner",
            "destination": "/planner.html"
        },
        {
            "source": "/roshplanner/",
            "destination": "/planner.html"
        },
        {
            "source": "/roshplanner/:path*",
            "destination": "/planner.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "mainstreetai.propertystars.app"
                }
            ],
            "destination": "/site/mainstreetai",
            "permanent": false
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "planner.propertystars.app"
                }
            ],
            "destination": "/vijayplanner/",
            "permanent": false
        }
    ]
}
